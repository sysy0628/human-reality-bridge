BRIDGE_POLL_MINUTES=10
BRIDGE_DATA_DIR=./data
BRIDGE_CONFIG=./config.json
BRIDGE_NETWORK_MODE=https
BRIDGE_SEND_STARTUP_TEST=false

# 直接 Aru 外部触发器路径：仅填写宿主机文件路径与公开 origin，不要写入秘密正文。
# BRIDGE_ARU_SENDER_HOST_PATH=/absolute/path/to/compatible/wake-send.mjs
# BRIDGE_CONTROL_ALLOWED_ORIGINS=https://your-card-origin.example
# BRIDGE_CONTROL_HOST_PORT=9443
# BRIDGE_CONTROL_TLS_KEY_HOST_PATH=/absolute/path/to/control-tls.key
# BRIDGE_CONTROL_TLS_CERT_HOST_PATH=/absolute/path/to/control-tls.crt
# BRIDGE_CONTROL_TOKEN_HOST_PATH=/absolute/path/to/control-token
